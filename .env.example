# Este archivo es solo un ejemplo de referencia: los valores reales de este
# coche ya estan configurados por defecto en docker-compose.yml y en
# scripts/obd_rfcomm_bind.sh, asi que NO es necesario crear un .env ni copiar
# este fichero para que Jarvis funcione tras un `git pull`. Crea un .env solo
# si quieres sobreescribir algun valor (p.ej. para probar con otro adaptador).

# --- OBD-II ---
OBD_MOCK=false
OBD_PORT=/dev/rfcomm0
# MAC del adaptador ELM327 u OBD-II Bluetooth. Necesaria para vincularlo
# a /dev/rfcomm0 automaticamente antes de arrancar el contenedor.
# Valor por defecto real de este coche: 04:25:E8:5B:01:EB
OBD_BT_MAC=04:25:E8:5B:01:EB
OBD_READ_INTERVAL=1.0
OBD_DTC_INTERVAL=30.0
OBD_RECONNECT_INTERVAL=10.0
OBD_MAX_RECONNECT_INTERVAL=300.0

# --- LEDs BLE ---
LED_ENABLED=true
LED_MAC=BE:27:C8:00:C4:D9
LED_BLE_TIMEOUT=15.0

# --- Servidor web ---
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_LOG_LEVEL=info
