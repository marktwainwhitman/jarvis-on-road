[Unit]
Description=Jarvis On Road
Requires=docker.service obd_rfcomm_keepalive.service bluetooth.service
After=docker.service obd_rfcomm_keepalive.service bluetooth.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/home/star/jarvis-on-road

# Carga variables de entorno opcionales para sobreescribir los valores por
# defecto (ya configurados para este coche en docker-compose.yml y
# scripts/obd_rfcomm_bind.sh). El "-" inicial hace que el servicio arranque
# igual aunque el fichero no exista: no es necesario crear un .env a mano.
# Ajusta la ruta si clonaste el repo en otro sitio.
EnvironmentFile=-/home/star/jarvis-on-road/.env

# Asegura que el adaptador OBD-II este vinculado a /dev/rfcomm0
# antes de levantar el contenedor. Si falla, el contenedor arranca igual
# y el lector OBD reintentara la conexion por software.
ExecStartPre=/home/star/jarvis-on-road/scripts/obd_rfcomm_bind.sh

# NOTA: no se reconstruye la imagen automaticamente en el arranque del servicio
# porque en Raspberry Pi Zero 2 W el build puede tardar mucho o quedarse
# sin memoria. Construye la imagen manualmente tras un git pull o cambio en
# requirements.txt/Dockerfile con:
#
#   cd /home/star/jarvis-on-road
#   docker compose build
#
# El servicio solo levanta el contenedor existente.
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
